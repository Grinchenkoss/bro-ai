# Пример конфигурации бота. Скопировать в .env на сервере (chmod 600), заполнить.
# .env в git НЕ коммитится (см. .gitignore).

BOT_TOKEN=123456789:ЗАМЕНИ_НА_ТОКЕН_ОТ_BOTFATHER
OWNER_ID=000000000                     # твой Telegram user ID (лок бота)
PROJECTS_DIR=/root/projects            # где лежат клоны проектов
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-... # из `claude setup-token`

# --- веб-консоль (Ф6), если поднимаешь web/ ---
# WEB_PASSWORD=ЗАМЕНИ_НА_ДЛИННЫЙ_ПАРОЛЬ   # вход в браузерную консоль

# --- необязательное (значения по умолчанию) ---
# MAX_TURNS=40           # потолок шагов агента на задачу
# RUN_TIMEOUT=1800       # таймаут одной задачи, сек
# WINDOW_SEC=18000       # окно учёта расхода токенов, сек (~5ч)
# ALLOWED_TOOLS=Read Write Edit Bash Grep Glob WebFetch WebSearch TodoWrite
# READONLY_TOOLS=Read Grep Glob WebFetch WebSearch
